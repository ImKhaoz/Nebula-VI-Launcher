<Window x:Class="XboxEmulatorUI.DiagnosticsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Nebula · Diagnostics" Width="850" Height="630" MinWidth="680" MinHeight="480"
 WindowStartupLocation="CenterOwner" Background="#161616" Foreground="#F4F1EB"
 FontFamily="Segoe UI Variable, Segoe UI">
 <Window.Resources>
  <Style x:Key="DiagnosticAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#272727"/><Setter Property="BorderBrush" Value="#6D665C"/>
   <Setter Property="Padding" Value="15,13"/><Setter Property="Margin" Value="0,0,8,6"/>
  </Style>
 </Window.Resources>
 <Grid Margin="28">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Border Background="#232323" BorderBrush="#635C51" BorderThickness="1" CornerRadius="17" Padding="20,14">
   <StackPanel>
    <TextBlock Text="Runtime diagnostics" FontSize="30" FontWeight="Light"/>
    <TextBlock Text="Check guest execution, Direct3D 12 output, and CPU and shader recompilation." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#C9C3B9"/>
   </StackPanel>
  </Border>
  <WrapPanel x:Name="Actions" Grid.Row="1" Margin="0,19,0,13">
   <Button Content="Run Series guest" Click="Guest_Click" Style="{StaticResource DiagnosticAction}"/>
   <Button Content="Test GPU" Click="Gpu_Click" Style="{StaticResource DiagnosticAction}"/>
   <Button Content="Test WARP" Click="Warp_Click" Style="{StaticResource DiagnosticAction}"/>
   <Button Content="Test recompilation" Click="Recomp_Click" Style="{StaticResource DiagnosticAction}"/>
  </WrapPanel>
  <TextBlock x:Name="Result" Grid.Row="2" Text="Choose a check" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,9"/>
  <TextBox x:Name="Output" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap"
   VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
   AutomationProperties.Name="Diagnostic output"/>
  <Button Grid.Row="4" Content="Save report" HorizontalAlignment="Right" Margin="0,14,0,0" Click="Save_Click"/>
 </Grid>
</Window>
