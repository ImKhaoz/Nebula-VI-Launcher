<Window x:Class="XboxEmulatorUI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Nebula — Game Library" Width="1440" Height="860" MinWidth="1000" MinHeight="650"
 WindowStartupLocation="CenterScreen" WindowStyle="None" WindowState="Maximized" Icon="Assets/Nexus.ico"
 Background="#18101F" Foreground="#FBF2F8" FontFamily="Segoe UI Variable Text, Segoe UI">
 <Window.Resources>
  <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#403E234B"/>
   <Setter Property="BorderBrush" Value="#50EBC5EE"/>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#69405E"/>
   <Setter Property="BorderBrush" Value="#EBA9C8"/>
  </Style>
 </Window.Resources>
 <Grid x:Name="LauncherRoot" ClipToBounds="True">
  <Image x:Name="Backdrop" Stretch="UniformToFill" IsHitTestVisible="False"/>
  <Rectangle IsHitTestVisible="False">
   <Rectangle.Fill>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.65">
     <GradientStop Color="#EE070D1C" Offset="0"/>
     <GradientStop Color="#99091023" Offset="0.43"/>
     <GradientStop Color="#18070E21" Offset="1"/>
    </LinearGradientBrush>
   </Rectangle.Fill>
  </Rectangle>
  <Rectangle IsHitTestVisible="False">
   <Rectangle.Fill>
    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
     <GradientStop Color="#88040A17" Offset="0"/>
     <GradientStop Color="#00040A17" Offset="0.48"/>
     <GradientStop Color="#EA060B16" Offset="1"/>
    </LinearGradientBrush>
   </Rectangle.Fill>
  </Rectangle>
  <Grid x:Name="NativeDashboard" Visibility="Hidden">
   <Grid.RowDefinitions>
    <RowDefinition Height="82"/><RowDefinition Height="178"/><RowDefinition Height="*"/><RowDefinition Height="61"/>
   </Grid.RowDefinitions>
   <Border Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <Grid Margin="52,0,28,0">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Image x:Name="HeaderLogo" Width="42" Height="28" VerticalAlignment="Center" Margin="0,0,2,0"/>
      <Image x:Name="HeaderWordmark" Width="96" VerticalAlignment="Center" Margin="0,0,28,0" AutomationProperties.Name="Nebula"/>
      <Button Content="Games" Style="{StaticResource Quiet}" Click="LibraryNav_Click"/>
      <Button Content="Recent" Style="{StaticResource Quiet}" Click="RecentNav_Click" Margin="9,0,0,0"/>
      <Button Content="Diagnostics" Style="{StaticResource Quiet}" Click="Diagnostics_Click" Margin="9,0,0,0"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <Button Content="Search" Style="{StaticResource Quiet}" Click="FocusSearch_Click"/>
      <Button Content="Settings" Style="{StaticResource Quiet}" Click="Help_Click" Margin="8,0,12,0"/>
      <Button Content="—" Click="Minimize_Click" Style="{StaticResource Quiet}" Padding="12,9"/>
      <Button Content="×" Click="Close_Click" Style="{StaticResource Quiet}" Padding="12,9" Margin="6,0,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="1" Margin="52,0">
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock x:Name="LibraryHeading" Text="Your games" FontSize="15" FontWeight="SemiBold"/>
     <TextBlock x:Name="GameCount" Foreground="#B4C8ED" Margin="6,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <TextBox x:Name="SearchBox" Width="168" Height="33" Padding="9,5" VerticalContentAlignment="Center" ToolTip="Filter by game name" TextChanged="SearchBox_TextChanged"/>
     <ComboBox x:Name="SortBox" Width="128" Height="32" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged">
      <ComboBoxItem Content="Recently added"/><ComboBoxItem Content="Name A–Z"/>
     </ComboBox>
    </StackPanel>
    <DockPanel Grid.Row="1" LastChildFill="True">
     <Button DockPanel.Dock="Left" Width="116" Height="111" VerticalAlignment="Top" Margin="0,7,13,0" Style="{StaticResource Quiet}" Click="AddGame_Click">
      <StackPanel><TextBlock Text="+" FontSize="31" HorizontalAlignment="Center"/><TextBlock Text="Add game"/></StackPanel>
     </Button>
     <Button DockPanel.Dock="Left" Width="116" Height="111" VerticalAlignment="Top" Margin="0,7,13,0" Style="{StaticResource Quiet}" Click="Diagnostics_Click">
      <StackPanel><TextBlock Text="◇" FontSize="27" HorizontalAlignment="Center"/><TextBlock Text="Diagnostics"/></StackPanel>
     </Button>
     <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="GameList">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border Width="138" Height="111" Margin="0,7,13,5" CornerRadius="12" Padding="8" Background="{Binding CoverBrush}" ToolTip="{Binding ExecutableName}" MouseLeftButtonUp="GameTile_Click">
          <Border.Style><Style TargetType="Border">
           <Setter Property="BorderBrush" Value="#597899BC"/><Setter Property="BorderThickness" Value="2"/>
           <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#D3E5FF"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#D3E5FF"/></Trigger>
           </Style.Triggers>
          </Style></Border.Style>
          <Grid>
           <TextBlock Text="{Binding Monogram}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"/>
           <TextBlock Text="{Binding PlatformLabel}" FontSize="8" Foreground="#DEE8FF" VerticalAlignment="Bottom" Margin="0,0,0,17"/>
           <Button Content="▶" ToolTip="Launch" Click="PlayGame_Click" Padding="6,1" HorizontalAlignment="Right" VerticalAlignment="Top"/>
           <Button Content="×" ToolTip="Remove from library" Click="RemoveGame_Click" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Top"/>
          </Grid>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
    </DockPanel>
   </Grid>
   <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="52,0,0,0">
    <TextBlock x:Name="FeatureTitle" Text="Game library" FontSize="55" FontWeight="Light" MaxWidth="590" TextWrapping="Wrap"/>
    <TextBlock x:Name="LibrarySubheading" FontSize="16" Foreground="#B9CCEC" Margin="2,8,0,28"/>
    <StackPanel Orientation="Horizontal">
     <Button x:Name="FeatureAction" Content="Add Windows game" Style="{StaticResource Primary}" Click="FeatureAction_Click"/>
     <Button Content="Add Xbox title" Style="{StaticResource Quiet}" Click="AddXboxTitle_Click" Margin="10,0,0,0"/>
    </StackPanel>
   </StackPanel>
   <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="#465F7E" Background="#45020814">
    <Grid Margin="52,0">
     <TextBlock Text="Copyright © Khaoz Entertainment. All rights reserved."
                HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9EAFCE" FontSize="10"/>
    </Grid>
   </Border>
  </Grid>
  <Border x:Name="Splash" Background="#0B0A0A" Panel.ZIndex="9" MouseLeftButtonUp="DismissSplash_Click">
   <Grid>
   <Grid ClipToBounds="True">
    <Grid.Background>
     <RadialGradientBrush Center=".5,.42" GradientOrigin=".5,.4" RadiusX=".64" RadiusY=".72">
      <GradientStop Color="#3B244B" Offset="0"/><GradientStop Color="#271A38" Offset=".48"/><GradientStop Color="#141019" Offset="1"/>
     </RadialGradientBrush>
    </Grid.Background>
    <Image x:Name="SplashBackdrop" Stretch="UniformToFill" Opacity=".24" IsHitTestVisible="False"/>
    <Grid x:Name="SplashGlow" Width="940" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
     <Ellipse Width="620" HorizontalAlignment="Left">
      <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#62FFAB79"/><GradientStop Color="#00FFAB79" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
     </Ellipse>
     <Ellipse Width="620" HorizontalAlignment="Right">
      <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#609D78F2"/><GradientStop Color="#009D78F2" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
     </Ellipse>
    </Grid>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
     <Grid x:Name="SplashMark" Width="540" Height="360" Opacity="0" ClipToBounds="True" RenderTransformOrigin=".5,.5">
      <Grid.RenderTransform><ScaleTransform x:Name="SplashZoom" ScaleX=".88" ScaleY=".88"/></Grid.RenderTransform>
      <TextBlock x:Name="SplashFallback" Text="N" FontSize="120" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Image x:Name="SplashLogo" Stretch="Uniform" AutomationProperties.Name="Nebula"/>
      <Grid IsHitTestVisible="False">
       <Grid.OpacityMask><ImageBrush x:Name="SplashSheenMask" Stretch="Uniform"/></Grid.OpacityMask>
       <Rectangle Width="165" HorizontalAlignment="Center">
       <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,.72" EndPoint="1,.28">
         <GradientStop Color="#00FFD0AC"/>
         <GradientStop Color="#68FFF3D9" Offset=".48"/>
         <GradientStop Color="#00CBABFF" Offset="1"/>
        </LinearGradientBrush>
       </Rectangle.Fill>
       <Rectangle.RenderTransform><TranslateTransform x:Name="SplashSweep" X="-410"/></Rectangle.RenderTransform>
       </Rectangle>
      </Grid>
     </Grid>
     <StackPanel x:Name="SplashCaption" Opacity="0" Margin="0,4,0,0">
      <Image x:Name="SplashWordmark" Width="216" HorizontalAlignment="Center" AutomationProperties.Name="Nebula"/>
      <Border Width="124" Height="1" Margin="0,16,0,0" RenderTransformOrigin=".5,.5">
       <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FFC39D"/><GradientStop Color="#EE91C5" Offset=".48"/><GradientStop Color="#B5A3F4" Offset="1"/></LinearGradientBrush></Border.Background>
       <Border.RenderTransform><ScaleTransform x:Name="SplashLineScale" ScaleX="0"/></Border.RenderTransform>
      </Border>
     </StackPanel>
    </StackPanel>
    <StackPanel x:Name="SplashLoading" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,46">
     <TextBlock Text="Loading your library…" Foreground="#DDEAF5" FontSize="15" HorizontalAlignment="Center"/>
     <ProgressBar x:Name="SplashLoadingBar" Width="170" Height="3" Margin="0,14,0,0"
                  Foreground="#FFC39D" Background="#423149" AutomationProperties.Name="Loading your library"/>
    </StackPanel>
    <Border x:Name="SplashSkipHint" BorderBrush="#3D3730" BorderThickness="1" CornerRadius="7" Padding="8,5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,20">
     <TextBlock Text="Esc to skip" Foreground="#C1B7A8" FontSize="11"/>
    </Border>
   </Grid>
   <Border x:Name="RecordingLeadIn" Background="#0B0A0A" Visibility="Collapsed">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
     <TextBlock Text="Recording delay" Foreground="#C6AF91" FontSize="13" HorizontalAlignment="Center"/>
     <TextBlock x:Name="RecordingSeconds" Foreground="#F3EFE7" FontSize="58" FontWeight="Light" HorizontalAlignment="Center" AutomationProperties.Name="Seconds until splash"/>
     <TextBlock Text="Enter or click to start  ·  Esc to skip" Foreground="#B6ADA2" FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0"/>
    </StackPanel>
   </Border>
   </Grid>
  </Border>
  <Border x:Name="Toast" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,35,74" Background="#1A2945" BorderBrush="#5877A2" BorderThickness="1" CornerRadius="10" Padding="14,10" Visibility="Collapsed" Panel.ZIndex="10">
   <TextBlock x:Name="ToastText" MaxWidth="460" TextWrapping="Wrap" FontSize="13"/>
  </Border>
 </Grid>
</Window>
