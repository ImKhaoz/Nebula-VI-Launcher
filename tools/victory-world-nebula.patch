+
+    #[cfg(feature = "diagnostics")]
+    struct AccountPickerTrigger {
+        path: std::path::PathBuf,
+        next_check: Instant,
+        pressed_at: Option<Instant>,
+    }
+
+    #[cfg(feature = "diagnostics")]
+    impl AccountPickerTrigger {
+        fn sample(&mut self, now: Instant) -> bool {
+            if let Some(pressed) = self.pressed_at {
+                return now.saturating_duration_since(pressed) < Duration::from_millis(200);
+            }
+            if now < self.next_check {
+                return false;
+            }
+            self.next_check = now + Duration::from_millis(100);
+            if !self.path.is_file() {
+                return false;
+            }
+            self.pressed_at = Some(now);
+            tracing::info!("account picker test: Enter injected");
+            true
+        }
+    }
+
+    /// One in-process Enter tap, triggered by the visual startup test.
+    #[cfg(feature = "diagnostics")]
+    fn account_picker_enter() -> bool {
+        use std::sync::Mutex;
+
+        static TRIGGER: LazyLock<Option<Mutex<AccountPickerTrigger>>> = LazyLock::new(|| {
+            std::env::var_os("VICTORY_TEST_ENTER_FILE").map(|path| {
+                Mutex::new(AccountPickerTrigger {
+                    path: path.into(),
+                    next_check: Instant::now(),
+                    pressed_at: None,
+                })
+            })
+        });
+        let Some(trigger) = &*TRIGGER else { return false };
+        let mut trigger = trigger.lock().unwrap_or_else(|error| error.into_inner());
+        trigger.sample(Instant::now())
+    }
+
+    #[cfg(all(test, feature = "diagnostics"))]
+    #[test]
+    fn picker_signal_triggers_a_single_enter_tap() {
+        let temp = tempfile::tempdir().unwrap();
+        let path = temp.path().join("press-enter");
+        let start = Instant::now();
+        let mut trigger = AccountPickerTrigger {
+            path: path.clone(),
+            next_check: start,
+            pressed_at: None,
+        };
+        assert!(!trigger.sample(start));
+        std::fs::write(path, []).unwrap();
+        assert!(!trigger.sample(start + Duration::from_millis(50)));
+        assert!(trigger.sample(start + Duration::from_millis(100)));
+        assert!(trigger.sample(start + Duration::from_millis(299)));
+        assert!(!trigger.sample(start + Duration::from_millis(300)));
+        assert!(!trigger.sample(start + Duration::from_secs(1)));
     }
 
